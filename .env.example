# Copy this file to .env and fill in the values. Never commit .env.

# TMDB (required): the "API Read Access Token" from https://www.themoviedb.org/settings/api
# A free TMDB account is enough.
EXPO_PUBLIC_TMDB_API_KEY=

# Supabase (required for sign-in and sync): Project Settings > API in your Supabase dashboard
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# Google Sign-In (optional): OAuth client IDs from Google Cloud Console
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID=
