# TMDB API
EXPO_PUBLIC_TMDB_API_KEY=your_tmdb_api_key_here

# Supabase (get these from your Supabase project dashboard)
EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your_anon_key_here

# Server-only keys (NOT prefixed with EXPO_PUBLIC_ — never bundled into client app)
# Only needed for server-side/admin scripts, not required for the mobile app
# SUPABASE_SERVICE_ROLE=your_service_role_key_here
# SUPABASE_SECRET_KEY=your_secret_key_here
